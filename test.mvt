// 元のオブジェクト
type obj1 = {"hoge": number, "fuga": {"piyo": number}[]};
const o1: obj1 = {"hoge": 12, "fuga": [{"piyo": 34}, {"piyo": 56}]} ;
// 圧縮しようとすればこんな感じにできる
// type obj2 = [number, (number[])[]];
// const o2: obj2 = [12, [[34], [56]]];

type aaa<T extends obj1> = {"hoge": T[0], "fuga": {"piyo": T[1][number][0]}[]};

class bbb<T extends obj2> {
  d: T;
  constructor(data: T) {
    this.d = data;
    return this;
  }

  get(): aaa<T> {return {} as unknown as aaa<T>}
}

const o3 = new bbb(o2);

const ccc = o3.get();

type a = typeof ccc;

